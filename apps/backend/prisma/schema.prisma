generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())

  projects Project[]
  apiKeys  ApiKey[]
}

// Chave pessoal para clientes externos (extensão, scripts): enviada como
// `Authorization: Bearer tsx_...`. Só o sha256 é guardado.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  READY
  ERROR
}

/// IMAGE: OCR + tradução desenhada de volta na página (mangá/quadrinho).
/// DOCUMENT: texto extraído do PDF e traduzido como texto corrido.
enum ProjectKind {
  IMAGE
  DOCUMENT
}

model Project {
  id             String        @id @default(cuid())
  ownerId        String?
  owner          User?         @relation(fields: [ownerId], references: [id])
  name           String
  kind           ProjectKind   @default(IMAGE)
  sourceLanguage String
  targetLanguage String
  status         ProjectStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sourceFiles    SourceFile[]
  pages          Page[]
  pipelines      Pipeline[]
  jobs           Job[]
  exports        ExportArtifact[]
  documentBlocks DocumentBlock[]
}

model SourceFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  fileRef   String
  sizeBytes Int
  status    String   @default("pending") // pending | extracting | extracted | error
  createdAt DateTime @default(now())

  pages          Page[]
  documentBlocks DocumentBlock[]
}

model Page {
  id                String     @id @default(cuid())
  projectId         String
  project           Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceFileId      String
  sourceFile        SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  order             Int
  sourceImageRef    String
  inpaintedImageRef String?
  renderedImageRef  String? // null = página "suja", precisa re-render
  /// Revisão no leitor: preenchido quando o usuário marca a página como
  /// revisada; qualquer edição ou re-tradução volta para null.
  reviewedAt        DateTime?

  ocrRegions     OcrRegion[]
  /// Projeto DOCUMENT: imagem embutida no texto (bloco-imagem do leitor)
  documentBlocks DocumentBlock[]

  @@index([projectId, order])
}

model OcrRegion {
  id             String  @id @default(cuid())
  pageId         String
  page           Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  boundingBox    Json
  sourceText     String
  translatedText String?
  confidence     Float
  readingOrder   Int?
  orientation    String?
  // true = criada/editada pelo usuário; preservada ao re-rodar o pipeline
  manual         Boolean @default(false)

  @@index([pageId])
}

/// Parágrafo de um projeto DOCUMENT: unidade de tradução e de leitura em
/// texto corrido. Não tem boundingBox — o texto não volta para a imagem.
model DocumentBlock {
  id             String     @id @default(cuid())
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceFileId   String
  sourceFile     SourceFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  /// Página do arquivo original (1-based), usada como marcador na leitura
  pageNumber     Int
  /// Ordem de leitura dentro do projeto
  order          Int
  sourceText     String
  translatedText String?
  /// De onde saiu o texto: "text-layer" (pdftotext), "ocr" (PDF escaneado) ou "epub"
  origin         String     @default("text-layer")
  /// EPUB: posição no XHTML ("capítulo:bloco") para reescrever/ler o livro
  locator        String?
  /// Revisão no leitor (null = não revisado; edição/re-tradução zera)
  reviewedAt     DateTime?
  /// Bloco-imagem: imagem embutida no PDF (sourceText vazio). A Page dá o
  /// OCR → tradução → render do fluxo de imagem de graça.
  pageId         String?
  page           Page?      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
  @@index([sourceFileId])
}

model Pipeline {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  steps     Json // PipelineStep[]
  createdAt DateTime @default(now())
}

model Job {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageId            String?
  pipelineStepIndex Int?
  type              String // JobType
  status            String // JobStatus
  progress          Int       @default(0)
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  error             String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([projectId, status])
}

model ProviderConfig {
  id         String   @id @default(cuid())
  providerId String   @unique
  type       String
  config     Json
  isDefault  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model ApiCredential {
  id         String   @id @default(cuid())
  providerId String   @unique
  encrypted  Bytes
  iv         Bytes
  updatedAt  DateTime @updatedAt
}

model ExportArtifact {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  format    String
  fileRef   String
  sizeBytes Int
  createdAt DateTime @default(now())
}
