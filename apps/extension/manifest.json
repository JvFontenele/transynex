{
  "manifest_version": 3,
  "name": "Transynex",
  "version": "0.1.0",
  "description": "Traduz imagens da página (HQs, mangás) usando seu servidor Transynex.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"], "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"] }],
  "action": { "default_popup": "popup.html", "default_title": "Transynex" },
  "browser_specific_settings": {
    "gecko": {
      "id": "transynex@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  }
}
